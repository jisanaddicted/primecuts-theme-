{%- style -%}
  /* Wrapper paints the Top/Bottom spacing area, so it must carry the exact
     same canvas as the inner .card-slider-section (color + image). Otherwise
     increasing the spacing shows a flat #17191d band that differs from the
     section body. The inner .card-slider-section is made transparent in
     theme-overrides.css so there is only one canvas. */
  #shopify-section-{{ section.id }} {
    background-color: #000000e8;
    background-image: url({{ '6807e2f3cafaf114d0f148fb_product-sec-bg.png' | asset_url }});
    background-position: 0 0;
    background-size: cover;
    background-repeat: no-repeat;
    padding-top: {{ section.settings.spacing_top }}px;
    padding-bottom: {{ section.settings.spacing_bottom }}px;
  }

  @media screen and (max-width: 991px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.spacing_top | times: 0.67 | round }}px;
      padding-bottom: {{ section.settings.spacing_bottom | times: 0.67 | round }}px;
    }
  }
{%- endstyle -%}

<section class="section-2 home-categories-intro" id="warum-generation-0">
  <div class="card-slider-section">
    <div
      class="div-block-9"
      {% if section.settings.header_bg_enabled %}
        style="background-color: {{ section.settings.header_bg_color }};"
      {% endif %}
    >
      <div class="text-block-7">{{ section.settings.heading }}</div>
      <div class="text-block-8">{{ section.settings.subheading }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home Categories Intro",
  "settings": [
    {
      "type": "checkbox",
      "id": "header_bg_enabled",
      "label": "Enable header background color",
      "default": false
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Header background color",
      "default": "#000000"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Vier Kategorien, ein Standard Echter Ursprung. Viroidfrei. <strong>Generation 0</strong>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Weil Genetik nur dann Ã¼berzeugt, wenn sie unverfÃ¤lscht, stabil und sauber ist â€“ vom ersten Schnitt an."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "info": "Space between this section and the one above. Scales to ~2/3 on mobile.",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "info": "Space between this section and the one below. Scales to ~2/3 on mobile.",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 108
    }
  ],
  "presets": [{ "name": "Home Categories Intro" }]
}
{% endschema %}
