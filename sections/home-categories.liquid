{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: #17191d;
    padding-top: {{ section.settings.spacing_top }}px;
    padding-bottom: {{ section.settings.spacing_bottom }}px;
  }

  @media screen and (max-width: 991px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.spacing_top | times: 0.67 | round }}px;
      padding-bottom: {{ section.settings.spacing_bottom | times: 0.67 | round }}px;
    }
  }
{%- endstyle -%}

<section class="section-2 home-categories">
  <div class="card-slider-section">
    <div class="pc-cats__stack">
      {%- assign pc_cat_names = 'Select|Classic|Elite|Royal' | split: '|' -%}
      {%- assign pc_cat_packs = 'W-Front-1.png,337,560;G-Front-1.png,337,555;B-Front-1.png,337,555;Front-orthographic-1.png,337,555' | split: ';' -%}
      {%- for pc_name in pc_cat_names -%}
        {%- assign pc_pack_parts = pc_cat_packs[forloop.index0] | split: ',' -%}
        {%- assign pc_pack_img = pc_pack_parts[0] -%}
        {%- assign pc_pack_w = pc_pack_parts[1] -%}
        {%- assign pc_pack_h = pc_pack_parts[2] -%}
        <article class="pc-cat">
          <div class="pc-cat__bg" aria-hidden="true">
            <span class="pc-cat__ghost">{{ pc_name }}</span>
            <svg class="pc-cat__beam" width="570" height="600" viewBox="0 0 570 600" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <g opacity="0.25" filter="url(#pcCatBeamFilter-{{ forloop.index0 }})">
                <rect width="46.9092" height="899.452" transform="matrix(0.72655 0.687113 -0.634428 0.772982 679.515 26.5078)" fill="url(#pcCatBeamGradient-{{ forloop.index0 }})"/>
              </g>
              <defs>
                <filter id="pcCatBeamFilter-{{ forloop.index0 }}" x="28.8782" y="-53.4922" width="764.719" height="887.492" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
                  <feFlood flood-opacity="0" result="BackgroundImageFix"/>
                  <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
                  <feGaussianBlur stdDeviation="40" result="effect1_foregroundBlur_2091_132330"/>
                </filter>
                <linearGradient id="pcCatBeamGradient-{{ forloop.index0 }}" x1="23.4546" y1="0" x2="23.4546" y2="899.452" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#CDCDCD"/>
                  <stop offset="1" stop-color="#FDF2D4"/>
                  </linearGradient>
              </defs>
            </svg>
            <span class="pc-cat__streak"></span>
            <img class="pc-cat__pack" src="{{ pc_pack_img | asset_url }}" alt="" loading="lazy" width="{{ pc_pack_w }}" height="{{ pc_pack_h }}">
            <div class="pc-cat__sky-spotlights" aria-hidden="true">
              <span class="pc-cat__spotlight pc-cat__spotlight--1"></span>
              <span class="pc-cat__spotlight pc-cat__spotlight--2"></span>
              <span class="pc-cat__spotlight pc-cat__spotlight--3"></span>
              <span class="pc-cat__spotlight pc-cat__spotlight--4"></span>
              <span class="pc-cat__spotlight pc-cat__spotlight--5"></span>
            </div>
          </div>

          <div class="pc-cat__content">
            <h2 class="pc-cat__title">{{ pc_name }}</h2>
            <p class="pc-cat__text">
              {%- case pc_name -%}
                {%- when 'Select' -%}
                  In unserer Select-Kategorie findest du Genetiken, die sich einen festen Platz in der Szene verdient haben – bekannt, gefragt und vielfach bewährt. Diese Cuts sind für alle, die auf Qualität setzen, ohne Kompromisse eingehen zu müssen.
                {%- when 'Classic' -%}
                  Stabile Klassiker und bewährte Cuts – sauber selektiert und konstant in Qualität und Performance.
                {%- when 'Elite' -%}
                  Für anspruchsvolle Grows: Terpenprofil, Struktur und Potenz auf einem Level.
                {%- when 'Royal' -%}
                  Limitierte Selektionen und seltene Genetiken – wenn nur das Beste zählt.
              {%- endcase -%}
            </p>
            <a href="{{ routes.all_products_collection_url }}" class="pc-cat__btn">Genetiken</a>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home Category Cards",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "info": "Space between this section and the one above. Scales to ~2/3 on mobile.",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "info": "Space between this section and the one below. Scales to ~2/3 on mobile.",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [{ "name": "Home Category Cards" }]
}
{% endschema %}
