{% comment %}
  Age Verification Modal — PrimeCuts themed.
  Render with {% render 'age-gate' %} right after <body> in layout/theme.liquid.
  Confirms 21+, remembers choice in localStorage for 30 days.
{% endcomment %}
<div id="age-gate-modal" class="age-gate-overlay" style="display:none" role="dialog" aria-modal="true" aria-labelledby="age-gate-title" aria-describedby="age-gate-desc">
  <div class="age-gate-card" role="document">
    <span class="age-gate-ghost" aria-hidden="true">21+</span>
    <div class="age-gate-pill" aria-hidden="true"><span class="age-gate-pill-dot"></span>Altersverifizierung</div>
    <h2 id="age-gate-title" class="age-gate-title">Age Verification Required</h2>
    <p id="age-gate-desc" class="age-gate-text">You must be at least 21 years old to enter this site.</p>
    <div class="age-gate-actions">
      <button id="age-gate-verify-btn" class="age-gate-btn age-gate-btn--primary" type="button">I am 21 or older</button>
      <button id="age-gate-deny-btn" class="age-gate-btn age-gate-btn--secondary" type="button">I am under 21</button>
    </div>
    <div id="age-gate-error" class="age-gate-error" style="display:none" role="alert"><p>Sorry, you must be of legal age to view this store.</p></div>
  </div>
</div>
<style>
.age-gate-overlay{position:fixed;inset:0;width:100vw;height:100vh;height:100dvh;background-color:rgba(0,0,0,.85);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);z-index:999999;display:flex;align-items:center;justify-content:center;padding:20px;box-sizing:border-box}
.age-gate-card{position:relative;width:100%;max-width:480px;box-sizing:border-box;background-color:#1d1f24;border:1px solid #40454a;border-radius:12px;box-shadow:4px 4px 12px rgba(0,0,0,.3),-4px -4px 12px rgba(122,134,151,.2);padding:48px 40px 40px;text-align:center;overflow:hidden;font-family:'Satoshi',Arial,sans-serif}
.age-gate-ghost{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:280px;font-weight:300;line-height:1;white-space:nowrap;background-image:linear-gradient(180deg,#fff 0%,#999 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.4);opacity:.05;pointer-events:none;user-select:none}
.age-gate-pill{position:relative;z-index:1;display:inline-flex;align-items:center;gap:8px;padding:6px 12px;margin:0 0 20px;min-height:32px;border-radius:999px;background-color:#0b0b0b;border:1px solid rgba(255,255,255,.14);color:#fff;font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase}
.age-gate-pill-dot{width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 12px rgba(34,197,94,.9)}
.age-gate-title{position:relative;z-index:1;margin:0 0 12px;color:#fff;font-size:32px;font-weight:300;line-height:1.2}
.age-gate-text{position:relative;z-index:1;margin:0 0 28px;color:#bebebe;font-size:16px;line-height:1.4}
.age-gate-btn{display:inline-flex;align-items:center;justify-content:center;min-height:54px;padding:0 24px;border:0;border-radius:8px;font-family:inherit;font-size:16px;font-weight:500;line-height:22px;text-decoration:none;cursor:pointer;transition:background-color .2s ease,border-color .2s ease}
.age-gate-btn--primary{background-color:#fff;color:#000;min-width:182px}
.age-gate-btn--primary:hover,.age-gate-btn--primary:focus-visible{background-color:#e9edf2}
.age-gate-btn--secondary{background-color:transparent;color:#fff;border:1px solid #fff;min-width:160px}
.age-gate-btn--secondary:hover,.age-gate-btn--secondary:focus-visible{background-color:rgba(255,255,255,.1)}
.age-gate-btn:focus-visible{outline:2px solid #fff;outline-offset:2px}
.age-gate-error{position:relative;z-index:1;margin-top:20px;padding:12px 16px;border-radius:8px;background:rgba(211,47,47,.12);border:1px solid rgba(211,47,47,.5);color:#ff8a80;font-size:14px;font-weight:500}
.age-gate-error p{margin:0}
@media screen and (max-width:479px){.age-gate-card{padding:36px 20px 28px}.age-gate-ghost{font-size:180px}.age-gate-title{font-size:26px}.age-gate-actions{flex-direction:column}.age-gate-btn{width:100%}}
</style>
<script>
(function(){function ready(fn){if(document.readyState!=='loading'){fn()}else{document.addEventListener('DOMContentLoaded',fn)}}ready(function(){var modal=document.getElementById('age-gate-modal');var verifyBtn=document.getElementById('age-gate-verify-btn');var denyBtn=document.getElementById('age-gate-deny-btn');var err=document.getElementById('age-gate-error');if(!modal||!verifyBtn||!denyBtn||!err)return;var KEY='age_verified';var DAYS=30;var verified=false;try{var raw=window.localStorage.getItem(KEY);if(raw){var data=null;try{data=JSON.parse(raw)}catch(e){data=null}var v=data&&data.v?data.v:raw;var t=data&&data.t?parseInt(data.t,10):0;if(v===true||v==='true'){if(!t||Date.now()-t<DAYS*24*60*60*1000){verified=true}else{window.localStorage.removeItem(KEY)}}}}catch(e){verified=false}if(!verified){modal.style.display='flex';document.body.style.overflow='hidden';document.documentElement.style.overflow='hidden';try{verifyBtn.focus()}catch(e){}}verifyBtn.addEventListener('click',function(){try{window.localStorage.setItem(KEY,JSON.stringify({v:true,t:Date.now()}))}catch(e){}modal.style.display='none';document.body.style.overflow='';document.documentElement.style.overflow=''});denyBtn.addEventListener('click',function(){err.style.display='block';verifyBtn.style.display='none';denyBtn.style.display='none'});});})();
</script>
